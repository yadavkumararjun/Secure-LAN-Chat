# Environment Configuration for Secure LAN Chat
APP_NAME="Secure LAN Chat Backend"
APP_ENV="development"
DEBUG=true

# Server Network Binding
HOST="0.0.0.0"
PORT=8000

# SQLite Storage Configuration (stored outside public root)
DATABASE_URL="sqlite:///./storage/data.db"
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_SIZE_BYTES=52428800  # 50 MB

# Session & Cookie Security
SESSION_EXPIRE_HOURS=24
COOKIE_SECURE=false  # Set to true when running over HTTPS/WSS (TLS)
COOKIE_NAME="session_id"
MAX_SESSIONS_PER_USER=5

# Rate Limiting & Connection Hardening
RATE_LIMIT_AUTH_ATTEMPTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_MESSAGES=10
RATE_LIMIT_CHAT_WINDOW_SECONDS=3.0
RATE_LIMIT_UPLOAD_FILES=15
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60.0
MAX_CONNECTIONS_PER_USER=10
MAX_TOTAL_CONNECTIONS=500
MAX_WS_FRAME_SIZE_BYTES=65536

# Cross-Origin Resource Sharing (Explicit LAN development origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000"

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL="INFO"
